luke_format = 0

package  = 'luaposix'
version  = '$USER/$gitref'

ldocs    = 'build-aux/config.ld.in'

release  = {
   news               = 'NEWS.md',
   rockspec           = 'luaposix-dev-1.rockspec',
   check_dependencies = true,
   add                = {'doc/'},
   replacements       = {
      {['README.md']  = {
         {['?branch=master'] = '?branch=release-v@version@'},
      }},
   },
   ['gh-pages']       = {
      {['.']    = 'doc/'},
      command   = 'rm -f examples/*.lua',
   },
}
